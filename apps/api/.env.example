NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://corner:corner_dev@127.0.0.1:3306/corner
CORS_ORIGINS=http://localhost:4200,capacitor://localhost,http://localhost
# Secreto de firma del token de acceso (mín. 32 caracteres)
JWT_ACCESS_SECRET=change-me-min-32-chars-change-me-min-32-chars
# Client IDs de Google (web, iOS, Android) separados por comas. Vacío = login con Google desactivado
GOOGLE_CLIENT_ID=
# Cookie de sesión Secure (por defecto true). En desarrollo local por HTTP pon false. NUNCA false en producción
COOKIE_SECURE=false
# Nº de proxies inversos propios delante de la API (Nginx, Caddy...). 0 = ignorar X-Forwarded-For
TRUST_PROXY_HOPS=0
